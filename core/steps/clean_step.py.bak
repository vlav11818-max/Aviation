"""Programmatic text cleanup step.

Performs **no API call**.  Applies regex-based and string-based cleanup
to the latest draft:

- Remove ``[Chapter X]``, ``Chapter One:``, ``Part III ---`` markers.
- Remove **language-specific** chapter markers loaded from cultural files
  via ``PromptManager.get_cleanup_patterns(language)``.
- Remove AI meta-comments (``Note:``, ``Author's note:``, etc.).
- Remove foreign-language stage directions (``*action*``, etc.).
- Normalise excessive whitespace.
- Normalise punctuation (straight quotes → curly, ``...`` → ellipsis,
  multiple punctuation → single).
- Strip UTF-8 BOM if present.

The cleaned text replaces the current draft version on the state.
"""

from __future__ import annotations

import logging
import re
from typing import TYPE_CHECKING

from core.events import EventBus, EventType
from core.exceptions import StepError
from core.state_manager import StateManager
from core.steps.base_step import BaseStep
from models.state import PipelineState

if TYPE_CHECKING:
    from core.api_client import APIClient
    from core.prompt_manager import PromptManager

logger = logging.getLogger(__name__)


# ── Compiled patterns ──────────────────────────────────────────────────

# [Chapter 1], [Chapter XII], [Part 3], [Part III]
_PAT_BRACKET_MARKERS = re.compile(
    r"\[(?:Chapter|Part|Section)\s+[\dIVXLCDMivxlcdm]+\]",
    re.IGNORECASE,
)

# "Chapter One:", "Chapter 1:", "Chapter XII:", "CHAPTER 1 -"
_PAT_CHAPTER_HEADERS = re.compile(
    r"^(?:Chapter|Part|Section)\s+"
    r"(?:[\dIVXLCDMivxlcdm]+|"
    r"One|Two|Three|Four|Five|Six|Seven|Eight|Nine|Ten|"
    r"Eleven|Twelve|Thirteen|Fourteen|Fifteen|"
    r"Sixteen|Seventeen|Eighteen|Nineteen|Twenty)"
    r"[\s:–\-—]*.*$",
    re.IGNORECASE | re.MULTILINE,
)

# "Part III ---", "Part 2 –", "PART ONE"
_PAT_PART_MARKERS = re.compile(
    r"^Part\s+[\dIVXLCDMivxlcdm]+[\s:–\-—]*$",
    re.IGNORECASE | re.MULTILINE,
)

# AI meta-comments
_PAT_META_COMMENTS = re.compile(
    r"^[\(\[]*(?:Note|Author'?s?\s*note|Editor'?s?\s*note|"
    r"Translator'?s?\s*note|AI\s*note|Disclaimer|"
    r"Content\s*warning|Trigger\s*warning)"
    r"[\)\]:]*\s*[:\-–]?\s*.*$",
    re.IGNORECASE | re.MULTILINE,
)

# "The End", "Fin", "Ende", etc. (basic — language-specific patterns
# loaded from cultural files supplement this).
_PAT_END_MARKERS = re.compile(
    r"^\s*(?:The\s+End|Fin|Ende|Конец|Кінець)\s*\.?\s*$",
    re.IGNORECASE | re.MULTILINE,
)

# Stage directions in asterisks: *action*, *whispers*, etc.
_PAT_STAGE_DIRECTIONS = re.compile(
    r"\*[^*]{2,80}\*"
)

# Multiple consecutive blank lines → single blank line.
_PAT_EXCESS_BLANKS = re.compile(r"\n{3,}")

# Multiple spaces → single space.
_PAT_EXCESS_SPACES = re.compile(r"[ \t]{2,}")

# Multiple periods (3+) → proper ellipsis character.
_PAT_MULTI_PERIODS = re.compile(r"\.{3,}")

# Multiple exclamation/question marks → single.
_PAT_MULTI_EXCL = re.compile(r"!{2,}")
_PAT_MULTI_QUEST = re.compile(r"\?{2,}")

# Section break markers: ***, ---, ~~~
_PAT_SECTION_BREAKS = re.compile(
    r"^\s*(?:\*\s*\*\s*\*|\*{3,}|-{3,}|~{3,}|#{3,})\s*$",
    re.MULTILINE,
)

# UTF-8 BOM.
_BOM = "\ufeff"


class CleanStep(BaseStep):
    """Programmatic text cleanup — no API call required.

    Applies a deterministic sequence of regex-based cleanups to the
    latest draft.  Language-specific cleanup patterns are loaded from
    cultural files via PromptManager.  The cleaned text is stored as
    the same draft version (i.e. it overwrites in place).
    """

    @property
    def name(self) -> str:
        return "clean"

    @property
    def description(self) -> str:
        return "Programmatic text cleanup (no API call)"

    async def execute(
        self,
        state: PipelineState,
        api_client: "APIClient",
        prompt_manager: "PromptManager",
        event_bus: EventBus,
    ) -> PipelineState:
        """Run text cleanup on the latest draft.

        Args:
            state: Current pipeline state (must have at least one draft).
            api_client: Unused (no API call).
            prompt_manager: Used to load language-specific cleanup patterns.
            event_bus: Event bus for GUI communication.

        Returns:
            Updated state with the cleaned draft.

        Raises:
            StepError: If no draft is available to clean.
        """
        logger.info("CleanStep: cleaning draft for '%s'", state.topic)

        if not state.drafts:
            raise StepError(
                f"CleanStep: no draft available for '{state.topic}'",
                step_name=self.name,
                recoverable=False,
            )

        event_bus.emit(
            EventType.STEP_STARTED,
            step=self.name,
            topic=state.topic,
            story_id=state.story_id,
        )

        # Load language-specific cleanup patterns.
        lang_patterns: list[re.Pattern] = []
        if prompt_manager is not None:
            raw_patterns = prompt_manager.get_cleanup_patterns(state.language)
            for pat_str in raw_patterns:
                try:
                    compiled = re.compile(pat_str, re.IGNORECASE | re.MULTILINE)
                    lang_patterns.append(compiled)
                except re.error as exc:
                    logger.warning(
                        "CleanStep: invalid cleanup pattern for '%s': %s — %s",
                        state.language,
                        pat_str,
                        exc,
                    )

        if lang_patterns:
            logger.info(
                "CleanStep: loaded %d language-specific patterns for '%s'",
                len(lang_patterns),
                state.language,
            )

        original = state.latest_draft
        cleaned = clean_text(original, extra_patterns=lang_patterns)

        # Determine current draft version (1-based).
        version = len(state.drafts)

        # Update the draft in-place.
        state_mgr = StateManager()
        state = state_mgr.add_draft(state, cleaned, version=version)

        # Save the cleaned draft.
        self._save_artifact(state, f"draft_v{version}.txt", cleaned)

        changes = _count_changes(original, cleaned)
        self._emit_progress(
            event_bus,
            state,
            f"Text cleaned: {changes} modification(s)",
        )
        logger.info(
            "CleanStep complete for '%s': %d modification(s)",
            state.topic,
            changes,
        )
        return state


# ── Public cleanup function ────────────────────────────────────────────


def clean_text(
    text: str,
    extra_patterns: list[re.Pattern] | None = None,
) -> str:
    """Apply all programmatic cleanup rules to *text*.

    This function is stateless and deterministic — ideal for unit
    testing independent of the pipeline.

    Args:
        text: Raw story text.
        extra_patterns: Additional compiled regex patterns to apply
            (typically language-specific patterns from cultural files).

    Returns:
        Cleaned text with markers, meta-comments, and punctuation
        issues resolved.
    """
    if not text:
        return text

    result = text

    # 1. Strip BOM.
    result = result.lstrip(_BOM)

    # 2. Remove bracketed markers: [Chapter 1], [Part III].
    result = _PAT_BRACKET_MARKERS.sub("", result)

    # 3. Remove chapter/part header lines.
    result = _PAT_CHAPTER_HEADERS.sub("", result)
    result = _PAT_PART_MARKERS.sub("", result)

    # 4. Remove "The End" and similar markers.
    result = _PAT_END_MARKERS.sub("", result)

    # 5. Remove section break markers (***, ---, ~~~).
    result = _PAT_SECTION_BREAKS.sub("", result)

    # 6. Apply language-specific patterns.
    if extra_patterns:
        for pattern in extra_patterns:
            result = pattern.sub("", result)

    # 7. Remove AI meta-comments.
    result = _PAT_META_COMMENTS.sub("", result)

    # 8. Remove stage directions in asterisks.
    result = _PAT_STAGE_DIRECTIONS.sub("", result)

    # 9. Normalise punctuation.
    result = _normalise_punctuation(result)

    # 10. Normalise whitespace.
    result = _normalise_whitespace(result)

    return result


# ── Internal helpers ───────────────────────────────────────────────────


def _normalise_punctuation(text: str) -> str:
    """Normalise common punctuation issues.

    Args:
        text: Input text.

    Returns:
        Text with normalised punctuation.
    """
    result = text

    # Straight quotes → curly quotes (simple heuristic).
    result = re.sub(r'(?<=\s)"(?=\S)', '\u201c', result)
    result = re.sub(r'^"(?=\S)', '\u201c', result)
    result = re.sub(r'(?<=\S)"(?=[\s.,;:!?\)]|$)', '\u201d', result)

    # Opening single quote.
    result = re.sub(r"(?<=\s)'(?=\S)", "\u2018", result)
    # Closing single quote (but not apostrophes mid-word).
    result = re.sub(r"(?<=\S)'(?=[\s.,;:!?\)]|$)", "\u2019", result)

    # Multiple periods → ellipsis.
    result = _PAT_MULTI_PERIODS.sub("\u2026", result)

    # Multiple exclamation marks → single.
    result = _PAT_MULTI_EXCL.sub("!", result)

    # Multiple question marks → single.
    result = _PAT_MULTI_QUEST.sub("?", result)

    # Straight double dashes → em dash.
    result = result.replace("--", "\u2014")

    return result


def _normalise_whitespace(text: str) -> str:
    """Normalise whitespace: collapse runs, trim lines, limit blank lines.

    Args:
        text: Input text.

    Returns:
        Text with normalised whitespace.
    """
    result = text

    # Collapse multiple spaces/tabs to single space (per line).
    lines = result.split("\n")
    lines = [_PAT_EXCESS_SPACES.sub(" ", line).strip() for line in lines]
    result = "\n".join(lines)

    # Collapse 3+ consecutive newlines to 2 (one blank line).
    result = _PAT_EXCESS_BLANKS.sub("\n\n", result)

    # Strip leading/trailing whitespace.
    result = result.strip()

    return result


def _count_changes(original: str, cleaned: str) -> int:
    """Count the approximate number of modifications between two texts.

    Args:
        original: Original text.
        cleaned: Cleaned text.

    Returns:
        Number of differing lines.
    """
    orig_lines = original.splitlines()
    clean_lines = cleaned.splitlines()

    changes = abs(len(orig_lines) - len(clean_lines))
    for o_line, c_line in zip(orig_lines, clean_lines):
        if o_line != c_line:
            changes += 1

    return changes
