"""Revision step based on evaluation feedback.

Renders the ``revision.txt`` template with the current draft, the
evaluation JSON, the critical issues list, the Story Bible, and
voiceover rules.  Sends the prompt to the LLM, saves the revised text
as the next draft version (``draft_vN.txt``), and updates the state.
Emits ``REVISION_STARTED``.

FIX: When word count is below target, the revision prompt now explicitly
instructs the LLM to EXTEND the story (add scenes, dialog, detail)
to reach the target.  Previously it said "maintain approximate length"
which caused the LLM to keep the short length.  max_tokens is now
target*3 instead of word_count*2 so there is room to expand.
"""

from __future__ import annotations

import json
import logging
from typing import TYPE_CHECKING

from core.events import EventBus, EventType
from core.exceptions import StepError
from core.state_manager import StateManager
from core.steps.base_step import BaseStep
from models.state import PipelineState

_state_mgr = StateManager()

if TYPE_CHECKING:
    from core.api_client import APIClient
    from core.prompt_manager import PromptManager

logger = logging.getLogger(__name__)


class ReviseStep(BaseStep):
    """Revise the draft based on evaluation feedback.

    Takes the evaluation results (issues and scores) and asks the LLM
    to fix only the identified problems while preserving everything
    else.  The revised text becomes the next draft version.

    When the current draft is significantly below the target word count,
    explicit expansion instructions are injected into the prompt so
    the LLM adds scenes, dialog, and detail instead of merely
    "maintaining approximate length".
    """

    @property
    def name(self) -> str:
        """Return the step name."""
        return "revise"

    @property
    def description(self) -> str:
        """Return a human-readable description."""
        return "Revise draft based on evaluation feedback"

    async def execute(
        self,
        state: PipelineState,
        api_client: "APIClient",
        prompt_manager: "PromptManager",
        event_bus: EventBus,
    ) -> PipelineState:
        """Run revision.

        Args:
            state: Current pipeline state (must have drafts and
                evaluations).
            api_client: Unified API client.
            prompt_manager: Template loader/renderer.
            event_bus: Event bus for GUI communication.

        Returns:
            Updated state with the new draft version appended.

        Raises:
            StepError: If prerequisites are missing or the API call fails.
        """
        logger.info(
            "ReviseStep: revising draft for '%s' (attempt %d)",
            state.topic,
            state.current_attempt,
        )

        if not state.drafts:
            raise StepError(
                f"ReviseStep: no draft to revise for '{state.topic}'",
                step_name=self.name,
                recoverable=False,
            )
        if not state.evaluations:
            raise StepError(
                f"ReviseStep: no evaluation available for '{state.topic}'",
                step_name=self.name,
                recoverable=False,
            )

        # Emit start event.
        event_bus.emit(
            EventType.REVISION_STARTED,
            step=self.name,
            topic=state.topic,
            story_id=state.story_id,
            attempt=state.current_attempt,
        )

        event_bus.emit(
            EventType.STEP_STARTED,
            step=self.name,
            topic=state.topic,
            story_id=state.story_id,
        )

        draft_text = state.latest_draft
        latest_eval = state.latest_evaluation

        # Build evaluation JSON string.
        eval_json = latest_eval.model_dump_json(indent=2) if latest_eval else "{}"

        # Build critical issues string.
        critical_issues_str = self._format_issues(latest_eval)

        # Story Bible JSON.
        story_bible_json = (
            state.story_bible.model_dump_json(indent=2)
            if state.story_bible
            else "{}"
        )

        # Voiceover rules.
        voiceover_rules = self._build_voiceover_rules(state)

        # ── Word count extension / reduction instructions ────────────
        gen = state.generation_config
        target = gen.target_words
        current_word_count = len(draft_text.split())
        target_min = int(target * 0.90)

        word_count_instructions = ""
        if current_word_count < target_min:
            deficit = target - current_word_count
            word_count_instructions = (
                f"\n\n## CRITICAL: WORD COUNT EXTENSION REQUIRED\n\n"
                f"The current draft is {current_word_count} words but the "
                f"target is {target} words.\n"
                f"You MUST ADD approximately {deficit} more words.\n\n"
                f"HOW TO EXTEND:\n"
                f"- Add new scenes between existing events (do NOT change "
                f"the plot, just flesh it out)\n"
                f"- Expand existing dialog exchanges — add more "
                f"back-and-forth\n"
                f"- Add sensory descriptions: sounds, smells, textures, "
                f"weather, lighting\n"
                f"- Add character internal monologue and emotional "
                f"reactions\n"
                f"- Add transitional moments between major scenes\n"
                f"- Describe settings and environments in more detail\n"
                f"- Add secondary character reactions and dialog\n\n"
                f"⚠️ Do NOT simply pad with repetition. Add genuine "
                f"narrative content.\n"
                f"⚠️ The revised story MUST be at least {target_min} "
                f"words.\n"
            )
        elif current_word_count > int(target * 1.15):
            excess = current_word_count - target
            word_count_instructions = (
                f"\n\n## NOTE: WORD COUNT REDUCTION\n\n"
                f"The current draft is {current_word_count} words but the "
                f"target is {target} words.\n"
                f"Trim approximately {excess} words by removing redundant "
                f"descriptions, tightening dialog, and cutting repetitive "
                f"passages.\n"
            )

        # Render prompt.
        prompt = prompt_manager.render(
            "revision",
            language=state.language,
            draft_text=draft_text,
            evaluation_json=eval_json,
            critical_issues=critical_issues_str,
            story_bible=story_bible_json,
            voiceover_rules=voiceover_rules,
            word_count_instructions=word_count_instructions,
        )

        # Use generous max_tokens — revision may need to expand the draft
        # significantly if the word count is below target.
        max_tokens = max(8192, target * 3)

        # Call LLM.
        try:
            revised_text = await api_client.send(
                messages=[{"role": "user", "content": prompt}],
                temperature=0.6,
                max_tokens=max_tokens,
            )
        except Exception as exc:
            raise StepError(
                f"Revision API call failed for '{state.topic}': {exc}",
                step_name=self.name,
                recoverable=True,
            ) from exc

        if not isinstance(revised_text, str):
            revised_text = getattr(revised_text, "text", str(revised_text))

        # Determine new version number.
        new_version = len(state.drafts) + 1

        # Save artifact.
        self._save_artifact(state, f"draft_v{new_version}.txt", revised_text)

        # Update state.
        state = _state_mgr.add_draft(state, revised_text, version=new_version)

        word_count = len(revised_text.split())
        self._emit_progress(
            event_bus,
            state,
            f"Revised draft v{new_version}: {word_count} words "
            f"(was {current_word_count}, target {target})",
        )
        logger.info(
            "ReviseStep complete for '%s': draft v%d, %d words (was %d, target %d)",
            state.topic,
            new_version,
            word_count,
            current_word_count,
            target,
        )
        return state

    @staticmethod
    def _format_issues(eval_result: "object | None") -> str:
        """Format evaluation issues as a human-readable string.

        Args:
            eval_result: The latest ``EvaluationResult``, or ``None``.

        Returns:
            Formatted string listing all issues by severity.
        """
        if eval_result is None:
            return "No evaluation issues available."

        all_issues = getattr(eval_result, "all_issues", [])
        if not all_issues:
            return "No specific issues identified."

        lines: list[str] = []
        for issue in all_issues:
            severity = getattr(issue, "severity", "unknown")
            category = getattr(issue, "category", "general")
            description = getattr(issue, "description", str(issue))
            line_ref = getattr(issue, "line_reference", "")

            entry = f"- [{severity}] {category}: {description}"
            if line_ref:
                entry += f" (at {line_ref})"
            lines.append(entry)

        return "\n".join(lines)

    @staticmethod
    def _build_voiceover_rules(state: PipelineState) -> str:
        """Build voiceover rules string from generation config.

        Args:
            state: Current pipeline state.

        Returns:
            Voiceover instructions string.
        """
        gen = state.generation_config
        rules: list[str] = []
        if gen.voiceover_optimized:
            rules.append("Text must be optimized for voiceover/TTS narration.")
        if gen.avoid_complex_sentences:
            rules.append("Use simple, clear sentences. Avoid nested clauses.")
        if gen.no_headers:
            rules.append(
                "Do NOT include chapter headers, section markers, or titles."
            )
        if gen.no_meta_comments:
            rules.append(
                "Do NOT include meta-comments, author's notes, or AI commentary."
            )
        if gen.pause_markers:
            rules.append(
                "Use natural punctuation for pauses: "
                "commas, periods, ellipses, em dashes."
            )
        return "\n".join(rules) if rules else "Maintain voiceover quality."
