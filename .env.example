# Aviation Content Factory — environment template.
# Copy this file to `.env` and fill in the providers you want to use.
# You only need one working provider to run end-to-end. If none are set,
# the pipeline falls back to the deterministic mock provider (mock/demo).

# --- OpenAI (direct) ---
OPENAI_API_KEY=

# --- Anthropic (direct) ---
ANTHROPIC_API_KEY=

# --- Google Gemini (direct) ---
GEMINI_API_KEY=

# --- OpenRouter (aggregator) ---
OPENROUTER_API_KEY=
# Optional: sent as headers to OpenRouter for attribution
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=aviation-content-factory

# --- DeepSeek ---
DEEPSEEK_API_KEY=

# --- kie.ai (Anthropic-Messages-compatible aggregator for Claude models) ---
# kie.ai proxies the Anthropic Messages API. Model slugs are Anthropic-style
# (claude-sonnet-4-5, claude-3-5-sonnet-20241022, claude-3-5-haiku-latest, ...).
KIE_API_KEY=
# The base URL: the client derives /messages from it. Works with any of:
#   https://api.kie.ai/claude
#   https://api.kie.ai/claude/v1
#   https://api.kie.ai/claude/v1/messages
KIE_BASE_URL=https://api.kie.ai/claude
# If your kie.ai dashboard shows a different endpoint (they occasionally
# change without updating docs), paste the FULL messages URL here to
# override KIE_BASE_URL and skip the /v1/messages derivation entirely.
# When set, this wins over KIE_BASE_URL for all kie/* calls.
# KIE_MESSAGES_URL=

# --- Any OpenAI-compatible proxy (LiteLLM proxy, LM Studio, vLLM, Ollama, …) ---
# Use model IDs prefixed with "custom/" or "openai/" to route here.
CUSTOM_API_KEY=
CUSTOM_BASE_URL=

# --- Behaviour ---
# Set to 1 to force the mock provider regardless of any key above.
AVIATION_FORCE_MOCK=0
# Log level for the pipeline (DEBUG / INFO / WARNING).
AVIATION_LOG_LEVEL=INFO
